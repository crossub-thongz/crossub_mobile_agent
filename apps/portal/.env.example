# Browser-side API base. '/api' is handled by app/api/[...path]/route.ts so cookies
# stay same-origin. Override only if bypassing the proxy (e.g. direct remote API).
NEXT_PUBLIC_API_URL=/api

# Server-side proxy target for the crossub_web Nest API.
# Local: http://localhost:3001 (run pnpm dev:api in crossub_web)
# Render: https://crossub-api-staging.onrender.com (no trailing slash)
# When using staging from http://localhost, the BFF rewrites Set-Cookie (Secure + SameSite).
API_INTERNAL_URL=https://crossub-api-staging.onrender.com

# Tenant app sign-in links from credential dialogs (local dev default :3003).
NEXT_PUBLIC_TENANT_APP_URL=http://localhost:3003

# Google Maps Platform — Places Autocomplete + map preview on Add Property.
# Enable "Maps JavaScript API" and "Places API" for this key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Staff web app (crossub_web) — PM links from the properties table open here.
NEXT_PUBLIC_CROSSUB_WEB_URL=http://localhost:3000
